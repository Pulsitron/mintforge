{
  "name": "nft-mint-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --import ./scripts/register-cloudflare-loader.mjs --test tests/rendered-html.test.mjs tests/upload-auth.test.mjs tests/interface.test.mjs tests/storage-checkout.test.mjs tests/storage-treasury.test.mjs tests/storage-setup-interface.test.mjs tests/pls-settlement.test.mjs tests/pls-checkout-interface.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "contracts:test": "node --test tests/contracts.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:interface": "node --test tests/interface.test.mjs",
    "test:scale": "node --test tests/collection-scale.test.mjs",
    "test:storage": "node --import ./scripts/register-cloudflare-loader.mjs --test tests/storage-checkout.test.mjs tests/storage-treasury.test.mjs tests/storage-setup-interface.test.mjs tests/pls-settlement.test.mjs tests/pls-checkout-interface.test.mjs"
  },
  "dependencies": {
    "@google/model-viewer": "4.3.1",
    "@irys/bundles": "0.0.5",
    "@openzeppelin/contracts": "5.4.0",
    "buffer": "6.0.3",
    "drizzle-orm": "0.45.2",
    "ethers": "6.15.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.27.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "6.2.4",
    "ganache": "7.9.2",
    "react-server-dom-webpack": "19.2.6",
    "react-test-renderer": "19.2.6",
    "solc": "0.8.30",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "node-stdlib-browser": "1.3.1"
  },
  "type": "module",
  "displayName": "NFT Mint Studio"
}
